# Copy this file to .env and fill in values as needed.
# The app boots and runs fine with NONE of these set — DB-backed
# features (analytics/session logs, admin sessions list) just no-op
# until DATABASE_URL is provided.

# PostgreSQL connection string (optional locally)
# DATABASE_URL=postgresql://user:password@localhost:5432/wolfbot

# Admin panel password (defaults to "wolf2024" if unset)
ADMIN_PASSWORD=wolf2024

# Session signing secret (any random string is fine for local dev)
SESSION_SECRET=dev-secret-change-me

# Port the server listens on (default 5000)
PORT=5000

NODE_ENV=development

# Public domain used for tenant routing and generated site URLs.
PLATFORM_DOMAIN=pairsite.space

# Google OAuth (leave blank locally - auth route is skipped until both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth (leave blank locally - auth route is skipped until both are set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Personal access token for GitHub API calls during site-creation repo
# verification (raises rate limit from 60/hr to 5000/hr). Not required
# locally, but strongly recommended in production.
GITHUB_TOKEN=

# Brevo transactional email (verification, clone-detection alerts).
# Leave BREVO_API_KEY blank locally - emails are skipped (logged) until set.
BREVO_API_KEY=
BREVO_SENDER_NAME=PairSite
BREVO_SENDER_EMAIL=noreply@pairsite.space

# Where clone-detection alerts are sent (if admin opts in)
ADMIN_EMAIL=
